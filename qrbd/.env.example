# Copy to .env locally. NEVER commit real tokens/keys or paste them in chat.
PORT=3000
QRBD_PUBLIC_URL=https://your-qrbd-domain.example
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QRBD_SECRET_KEY=
# Keep this encryption key stable and backed up securely; losing it makes saved
# merchant configs/payment snapshots unreadable. Database snapshots contain encrypted secrets.
# Optional platform activation merchant, separate from each shop's print-payment merchant.
QRBD_BILLING_STORE=
QRBD_BILLING_SIGNATURE=
QRBD_BILLING_MODE=sandbox
QRBD_ACTIVATION_TAKA=500
# Official WhatsApp Business Cloud API: one configured receiving shop per deployment.
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_SHOP_ID=
WA_GRAPH_VERSION=v22.0
# Never use this preview-only flag in production:
# QRBD_EMBED_PREVIEW=1

# Public beta deployment: required in production unless open registration is explicit.
# Generate locally: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
QRBD_REGISTRATION_CODE=
# QRBD_OPEN_REGISTRATION=true  # Only after reviewing abuse/security controls.
QRBD_TRUST_PROXY_HOPS=0
# Docker Compose + Caddy only (domain with DNS pointing at your VPS):
QRBD_DOMAIN=
# Production can generate a stable key on its private persistent disk if
# QRBD_SECRET_KEY is empty; protect/back up that .encryption-key file.
# Optional separate document directory (Render blueprint sets an ephemeral path).
# QRBD_FILE_DIR=/tmp/qrbd-print-files
# Ephemeral PDFs can vanish on deploy; missing paid jobs need reconciliation.
